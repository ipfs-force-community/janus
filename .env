# ============================
# Janus Docker 部署环境变量
# 使用前请复制此文件为 .env 并修改
#   cp .env.docker .env
# ============================

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=janus

# ----- Filecoin 节点 -----
# Indexer 连接 Filecoin 节点的 RPC 地址和 Token（必须配置）
FILECOIN_NODE_ENDPOINT=http://filecoin-mock:1234
FILECOIN_NODE_TOKEN=mock_token_for_testing

# ----- Indexer -----
# Indexer 轮询间隔（秒）
INDEXER_INTERVAL=10

# ----- Janus Miner -----
# 一次性数据同步任务的起止 epoch
MINER_START_EPOCH=5260000
MINER_END_EPOCH=5261000

# ----- Nginx -----
# 对外暴露的 HTTP 端口
NGINX_PORT=80
